<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ShopFlow Automation Suite" verbose="1" parallel="none" thread-count="1">
    <listeners>
        <listener class-name="com.automation.listeners.ScreenshotListener"/>
        <listener class-name="com.automation.listeners.ExtentReportListener"/>
    </listeners>

    <!-- UI classes are independent and each receives a separate BaseTest WebDriver instance. -->
    <test name="TestNG UI Regression Tests" parallel="classes" thread-count="3">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="com.automation.tests.LoginTest"/>
            <class name="com.automation.tests.InvalidLoginTest"/>
            <class name="com.automation.tests.LockedOutLoginTest"/>
            <class name="com.automation.tests.ProductsTest"/>
            <class name="com.automation.tests.ProductInteractionsTest"/>
            <class name="com.automation.tests.CartTest"/>
            <class name="com.automation.tests.CartWorkflowTest"/>
            <class name="com.automation.tests.CheckoutTest"/>
            <class name="com.automation.tests.CheckoutValidationTest"/>
            <class name="com.automation.tests.NavigationTest"/>
        </classes>

    </test>

    <!-- Kept sequential to avoid sharing Cucumber scenario state. -->
    <test name="Cucumber BDD Tests" parallel="none" thread-count="1">
        <classes>
            <class name="com.automation.runners.CucumberTestRunner"/>
        </classes>
    </test>

    <!-- Kept sequential because the public practice API is shared and simulated. -->
    <test name="REST Assured API Tests" parallel="none" thread-count="1">
        <classes>
            <class name="com.automation.api.tests.JsonPlaceholderApiTest"/>
        </classes>
    </test>

</suite>
