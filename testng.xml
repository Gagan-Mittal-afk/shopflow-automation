<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ShopFlow Automation Suite" verbose="1">
    <listeners>
        <listener class-name="com.automation.listeners.ScreenshotListener"/>
    </listeners>

    <test name="TestNG Regression Tests">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="com.automation.tests.LoginTest"/>
            <class name="com.automation.tests.InvalidLoginTest"/>
            <class name="com.automation.tests.ProductsTest"/>
            <class name="com.automation.tests.CartTest"/>
            <class name="com.automation.tests.CheckoutTest"/>
        </classes>

    </test>

    <test name="Cucumber BDD Tests">
        <classes>
            <class name="com.automation.runners.CucumberTestRunner"/>
        </classes>
    </test>

</suite>
